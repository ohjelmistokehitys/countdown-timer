{
    "name": "Countdown timer",
    "remoteEnv": {
        // dependency cooldown period to protect against supply chain attacks
        "npm_config_min_release_age": "7",
        // ignore pre and post install scripts from packages by default
        "npm_config_ignore_scripts": "true"
    }
}
